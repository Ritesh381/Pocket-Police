{
  "name": "vasuli-bhai-backend",
  "version": "1.0.0",
  "description": "Express API for Vasuli Bhai — personal debt tracker",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file=../.env src/index.js",
    "start": "node --env-file=../.env src/index.js",
    "reminders:manual": "node --env-file=../.env src/scripts/runReminders.js",
    "email:verify": "node --env-file=../.env src/scripts/verifyEmail.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^5.9.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "resend": "^4.0.0",
    "twilio": "^5.3.0",
    "zod": "^3.23.8"
  }
}
