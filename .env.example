# ── Supabase (required) ─────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>       # used by the mobile app (safe to expose)
SUPABASE_SECRET_KEY=<secret-key>                 # service-role key — server ONLY, never in the app
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Backend ─────────────────────────────────────────────
PORT=4000
CORS_ORIGINS=*                                   # e.g. https://app.example.com,http://localhost:8081

# ── Cron / reminders ────────────────────────────────────
CRON_SECRET=<long-random-string>                 # must match the GitHub repo secret

# ── Email (SMTP) — needed for email reminders ───────────
# Gmail / Google Workspace: host smtp.gmail.com, port 587, secure false,
# and SMTP_PASS = a 16-char Google "App Password" (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=
REMINDER_FROM_EMAIL=Vasuli Bhai <you@example.com>

# ── Twilio — needed for SMS / WhatsApp reminders ────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# ── Telegram bot (optional) ─────────────────────────────
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_BOT_USERNAME=         # the bot's username, e.g. PocketPoliceBot (no @)
TELEGRAM_WEBHOOK_SECRET=       # random string; also passed to setWebhook
